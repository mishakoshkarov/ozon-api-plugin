# Скопируйте этот файл в ~/.ozon-plugin/keys.env и впишите свои ключи.
# Ключи не вставляйте в чат с Claude — только в этот файл.

# Seller API: ЛК Ozon → Настройки → API-ключи. Роль ключа — «Администратор» или с правами на чтение нужных разделов.
OZON_CLIENT_ID=
OZON_API_KEY=

# Performance API (реклама): ЛК Ozon → Продвижение → Performance API → создать аккаунт.
# Можно оставить пустым — тогда не будут работать только инструменты рекламы.
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=
